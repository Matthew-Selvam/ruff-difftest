+    fn blank_line_insertion_offset(&self, following_indent_length: usize) -> TextSize {
+        match self.comment_block {
+            // Only anchor at the comment block when the block is written at the same
+            // indentation as the definition it documents. A block that starts inside the
+            // preceding suite — a trailing comment in the previous function's body, with or
